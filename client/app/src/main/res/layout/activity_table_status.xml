<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 상단 바 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로가기" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_restaurant_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="테이블 현황"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_ws_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="연결 중..."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <!-- 범례 -->
    <LinearLayout
        android:id="@+id/legend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="8dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/top_bar">

        <View android:layout_width="12dp" android:layout_height="12dp"
            android:background="#E8F5E9" android:layout_marginEnd="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="예약 가능" android:textSize="12sp" android:textColor="@color/text_secondary"
            android:layout_marginEnd="16dp"/>

        <View android:layout_width="12dp" android:layout_height="12dp"
            android:background="#FFF9C4" android:layout_marginEnd="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="예약 중" android:textSize="12sp" android:textColor="@color/text_secondary"
            android:layout_marginEnd="16dp"/>

        <View android:layout_width="12dp" android:layout_height="12dp"
            android:background="#FFEBEE" android:layout_marginEnd="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="착석 중" android:textSize="12sp" android:textColor="@color/text_secondary"/>
    </LinearLayout>

    <!-- 업주 모드 안내 (isOwner=true일 때만 표시) -->
    <TextView
        android:id="@+id/tv_owner_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF8E1"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="테이블을 길게 누르면 홀 손님 착석 잠금 / 해제를 할 수 있습니다"
        android:textColor="#F57F17"
        android:textSize="12sp"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/legend" />

    <!-- 테이블 그리드 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tables"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_owner_hint"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 테이블 없을 때 -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="등록된 테이블이 없습니다"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_owner_hint" />

</androidx.constraintlayout.widget.ConstraintLayout>
