<?xml version="1.0" encoding="utf-8"?>
<!--
  이 파일의 내용을 res/values/styles.xml (또는 themes.xml)에 합쳐 넣으세요.
  이미 <resources> 블록이 있으면 style 두 개만 그 안에 추가하면 됩니다.
-->
<resources>

    <!-- 폼 입력 라벨 -->
    <style name="FormLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <!-- 폼 입력 칸 -->
    <style name="FormInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:background">@drawable/bg_card_border</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">15sp</item>
    </style>

</resources>
