<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 인터넷 권한 (서버 통신, 이미지 로드 시 필요) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".app.App"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Java_Project"
        tools:targetApi="31">

        <!-- 메인 진입 -->
        <activity
            android:name=".activity.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 홈 -->
        <activity
            android:name=".activity.HomeActivity"
            android:exported="false" />

        <!-- 마이 페이지 -->
        <activity
            android:name=".activity.MyPageActivity"
            android:exported="false" />

        <!-- 닉네임 변경 -->
        <activity
            android:name=".activity.NicknameChangeActivity"
            android:exported="false"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- 프로필 변경 -->
        <activity
            android:name=".activity.ProfileChangeActivity"
            android:exported="false" />

        <!-- 마이 리스트 (내 게시물 / 답글 / 나만의 맛집) -->
        <activity
            android:name=".activity.MyListActivity"
            android:exported="false" />

        <!-- 정보 (앱 소개 / 공지사항 / 고객센터) -->
        <activity
            android:name=".activity.InfoActivity"
            android:exported="false" />

        <!-- 게시판 -->
        <activity
            android:name=".activity.BoardActivity"
            android:exported="false" />

        <!-- 게시물 상세 -->
        <activity
            android:name=".activity.PostDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 게시물 작성 -->
        <activity
            android:name=".activity.PostWriteActivity"
            android:exported="false"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- 검색 -->
        <activity
            android:name=".activity.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- 검색 결과 -->
        <activity
            android:name=".activity.SearchResultActivity"
            android:exported="false" />

        <!-- 가게 상세 -->
        <activity
            android:name=".activity.RestaurantDetailActivity"
            android:exported="false" />

        <!-- 지도 -->
        <activity
            android:name=".activity.MapActivity"
            android:exported="false" />

        <activity android:name=".activity.TestActivity"
            android:exported="false"/>

        <activity android:name=".activity.PreferenceEditActivity"
            android:exported="false" />
        <activity android:name=".activity.PasswordChangeActivity"
            android:exported="false"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <activity android:name=".activity.RestaurantFormActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".activity.MenuFormActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".activity.OwnerRestaurantActivity" android:exported="false" />
        <activity android:name=".activity.OwnerReservationActivity" android:exported="false" />
    </application>

</manifest>
